# Copy to .env for local development. docker-compose.yml sets its own values for containers.

NODE_ENV=development
PORT=4000

# Single-node replica set; required for multi-document transactions (corrections).
MONGO_URI=mongodb://localhost:27017/sycamore?replicaSet=rs0&directConnection=true

# HS256 signing secret for 1h access tokens. A throwaway value for local/dev use only.
JWT_SECRET=dev-only-secret-change-me

LOG_LEVEL=info

# Mock LLM provider, used when keyword rules do not decide a category.
# ok | slow | down | rate_limited | invalid
MOCK_LLM_MODE=ok
MOCK_LLM_FAILURE_RATE=0

WORKER_POLL_INTERVAL_MS=1000
WORKER_LOCK_MS=30000
WORKER_BATCH_SIZE=10

# Seed users (documented here so the README does not need to repeat passwords).
SEED_PASSWORD=Passw0rd!2024
